{
  "name": "osamah-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Development and Presentation Workspace",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix integrations/async run dev",
    "build": "npm run async:main && npm run async:renderer",
    "typecheck": "tsc --noEmit && npm run async:typecheck && npm run opencode:typecheck",
    "test": "npm run async:typecheck && npm run presenton:test && npm run starry:test",
    "lint": "npm run typecheck",
    "preview": "npm --prefix integrations/async run preview",
    "desktop": "npm run async:desktop",
    "desktop:dev": "npm run dev",
    "async:install": "npm --prefix integrations/async ci --ignore-scripts --no-audit --no-fund",
    "async:typecheck": "npm --prefix integrations/async run typecheck",
    "async:main": "npm --prefix integrations/async run build:main",
    "async:renderer": "npm --prefix integrations/async run build:renderer",
    "async:build": "npm run async:main && npm run async:renderer",
    "async:desktop": "npm --prefix integrations/async run desktop",
    "presenton:install": "npm --prefix integrations/presenton ci --ignore-scripts --no-audit --no-fund && npm --prefix integrations/presenton/servers/nextjs ci --ignore-scripts --no-audit --no-fund",
    "presenton:test": "npm --prefix integrations/presenton test",
    "presenton:build": "npm --prefix integrations/presenton/servers/nextjs run build",
    "starry:test": "npm --prefix integrations/starry-slides test",
    "opencode:install": "bun install --cwd integrations/opencode --frozen-lockfile --ignore-scripts",
    "opencode:typecheck": "bun run --cwd integrations/opencode/packages/core typecheck",
    "opencode:server": "bun run --cwd integrations/opencode/packages/opencode src/index.ts serve --hostname 127.0.0.1 --port 4096",
    "source:check": "npm run typecheck && npm run test && npm run presenton:build && npm run async:renderer && npm run async:main"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "electron": "latest"
  }
}
